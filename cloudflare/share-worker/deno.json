{
  "lock": false,
  // `privacy.ts` imports the repository's PRIVACY.md as text, the way
  // wrangler's bundler does at deploy.
  "unstable": ["raw-imports"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    // The tests read PRIVACY.md and this folder, to hold the page to the
    // file and to find any copy of it beside the Worker.
    "test": "deno test --allow-read=.,../../PRIVACY.md"
  }
}
