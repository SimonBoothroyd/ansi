{
  "lock": false,
  "fmt": { "lineWidth": 80 },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "imagescript": "https://deno.land/x/imagescript@1.3.0/mod.ts",
    "postgres": "https://deno.land/x/postgresjs@v3.4.5/mod.js"
  },
  "tasks": {
    // `--allow-read`: several tests read repo fixtures (the seed vocab, the
    // blessed extraction gold, the committed golden payload). Without it Deno
    // denies the read and a test that catches the failure SKIPS SILENTLY —
    // which is how `_shared/match.test.ts`'s calibration case was passing
    // without ever running. `--allow-env` is scoped to the flag that rewrites
    // the golden fixture, the household allowlist auth.test.ts sets and
    // restores around each case, and the two the keyless replay switch
    // reads (replay.test.ts sets and restores those the same way).
    "test": "deno test --allow-read --allow-env=UPDATE_GOLDEN,IMPORT_ALLOWED_HOUSEHOLDS,IMPORT_EXTRACT_FIXTURE,RECEIPT_EXTRACT_FIXTURE,ANTHROPIC_API_KEY",
    // Rewrite a TS→Dart contract fixture after an INTENTIONAL contract change,
    // then review the diff and update the Dart assertions. One task per door,
    // because the two goldens move for different reasons.
    "golden": "UPDATE_GOLDEN=1 deno test --allow-read --allow-write --allow-env=UPDATE_GOLDEN import-recipe/golden_payload.test.ts",
    "golden-receipt": "UPDATE_GOLDEN=1 deno test --allow-read --allow-write --allow-env=UPDATE_GOLDEN import-receipt/golden_payload.test.ts"
  }
}
