{
  "lock": false,
  "fmt": { "lineWidth": 80 },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/csv": "jsr:@std/csv@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "tasks": {
    // `--allow-read`: gen_admission_vectors.test.ts reads the shared vector
    // JSON and the pgTAP file it is rendered into. Without it Deno denies the
    // read and the drift check throws instead of comparing — a green run that
    // proved nothing.
    "test": "deno test --allow-read",
    "mine": "deno run --allow-net --allow-read --allow-write mine_recipes.ts",
    "gen-seed": "deno run --allow-read --allow-write gen_seed.ts",
    "gen-admission-vectors": "deno run --allow-read --allow-write gen_admission_vectors.ts"
  }
}
