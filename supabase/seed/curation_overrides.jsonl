// --- measures: rule output a human finds senseless -------------------------
{"kind": "drop_measure", "match_text": "corn tortilla", "label": "enchilada", "reason": "an enchilada is a dish made from a tortilla, not a unit of tortilla"}
{"kind": "drop_measure", "match_text": "active yeast dry", "label": "packet", "reason": "duplicate of the curated 7 g sachet (FDC 7.2 g packet is the same physical thing; two chips for one unit)"}
{"kind": "drop_measure", "match_text": "instant yeast", "label": "packet", "reason": "borrowed duplicate of the curated 7 g sachet — same physical unit twice"}
{"kind": "drop_measure", "match_text": "pine nut", "label": "nut", "reason": "nobody counts single pine nuts (0.17 g each) — they are spooned or weighed"}
