// curation_overrides.jsonl — the audited LLM-curation pass over the seed
// pipeline's rule output (plan 0013, Simon's seed-default methodology:
// rules are scaffolding, not the decider). One JSON object per line, every
// override with a reason; consumed by gen_measures.ts (drop/add_measure)
// and gen_seed.ts → seed_curation.sql (density / allowed_units).
// Reviewed 2026-08-29 against the full 291-ingredient listing.
//
// --- measures: rule output a human finds senseless -------------------------
{"kind": "drop_measure", "match_text": "corn tortilla", "label": "enchilada", "reason": "an enchilada is a dish made from a tortilla, not a unit of tortilla"}
{"kind": "drop_measure", "match_text": "active yeast dry", "label": "packet", "reason": "duplicate of the curated 7 g sachet (FDC 7.2 g packet is the same physical thing; two chips for one unit)"}
{"kind": "drop_measure", "match_text": "instant yeast", "label": "packet", "reason": "borrowed duplicate of the curated 7 g sachet — same physical unit twice"}
{"kind": "drop_measure", "match_text": "pine nut", "label": "nut", "reason": "nobody counts single pine nuts (0.17 g each) — they are spooned or weighed"}
{"kind": "drop_measure", "match_text": "soy sauce", "label": "packet", "reason": "the 8.9 g takeout packet is not how a kitchen measures soy sauce"}
{"kind": "drop_measure", "match_text": "arugula", "label": "leaf", "reason": "salad arugula is never counted by leaves (and 2 g/leaf describes a giant one)"}
{"kind": "drop_measure", "match_text": "spinach", "label": "leaf", "reason": "bagged spinach is never counted by leaves; FDC's 10 g leaf is a mature bunch leaf"}
{"kind": "drop_measure", "match_text": "mini pretzel", "label": "twist", "reason": "FDC 167555's 6 g twist is a full-size pretzel — ~5x a mini; wrong weight for this vocab row"}
//
// --- densities: FDC-derived value misleads ---------------------------------
{"kind": "density", "match_text": "banana", "value": 0.634, "reason": "the ranked pick landed on FDC's mashed cup (225 g -> 0.951); sliced (150 g/cup -> 0.634) is what a volume of banana means in a recipe"}
//
// --- allowed units: entry the rule missed ----------------------------------
{"kind": "allowed_units", "match_text": "coconut milk", "add": ["cup", "tbsp", "ml"], "reason": "count-default (sold by the can) but recipes also speak cups/tbsp of it, and its density makes volume honest"}
{"kind": "allowed_units", "match_text": "liquid smoke", "add": ["tsp"], "reason": "dash-default, but the recipes that measure it say 1/2 tsp — g alone is no way to say that"}
{"kind": "allowed_units", "match_text": "allspice ground", "add": ["tsp"], "reason": "pinch-default spice that recipes still spoon (1/2 tsp allspice)"}
{"kind": "allowed_units", "match_text": "clove ground", "add": ["tsp"], "reason": "pinch-default spice that recipes still spoon"}
{"kind": "allowed_units", "match_text": "nutmeg ground", "add": ["tsp"], "reason": "pinch-default spice that recipes still spoon"}
{"kind": "allowed_units", "match_text": "hot sauce", "add": ["to_taste"], "reason": "condiment-class pantry row (the vocab has no condiment category); hot sauce is added to taste"}
{"kind": "allowed_units", "match_text": "sriracha", "add": ["to_taste"], "reason": "condiment-class pantry row; added to taste"}
{"kind": "allowed_units", "match_text": "soy sauce", "add": ["to_taste"], "reason": "condiment-class pantry row; seasoned to taste"}
{"kind": "allowed_units", "match_text": "tamari", "add": ["to_taste"], "reason": "condiment-class pantry row; seasoned to taste"}
{"kind": "allowed_units", "match_text": "liquid amino", "add": ["to_taste"], "reason": "condiment-class pantry row; seasoned to taste"}
{"kind": "allowed_units", "match_text": "vegan worcestershire sauce", "add": ["to_taste"], "reason": "condiment-class pantry row; seasoned to taste"}
