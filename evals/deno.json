{
  // The eval runners import straight from `supabase/functions/_shared/**`, so
  // they need that project's import map. Without it, `deno run runner/…` from
  // `evals/` failed on the adapters' `imagescript` import and every documented
  // command needed an explicit `--config ../supabase/functions/deno.json`.
  // This file re-exports the same imports so the commands in
  // `runner/EXTRACTION.md` (and `runner/run.sh`) just work from `evals/`.
  //
  // Keep the `imports` block in step with `supabase/functions/deno.json` — it is
  // a mirror, not a second source of truth.
  "lock": false,
  // `fmt` covers the runner TypeScript only. `datasets/` is hand-curated data —
  // the gold JSON deliberately keeps one line item per line so diffs are
  // readable, which the formatter would explode — and the prose here predates
  // this config, so reflowing it all would bury the real changes. `reports/` is
  // generated output.
  "fmt": {
    "lineWidth": 80,
    "exclude": ["datasets/", "reports/", "**/*.md"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "imagescript": "https://deno.land/x/imagescript@1.3.0/mod.ts",
    "postgres": "https://deno.land/x/postgresjs@v3.4.5/mod.js"
  },
  "tasks": {
    "eval": "./runner/run.sh",
    "test": "deno test --allow-read --allow-env runner/"
  }
}
