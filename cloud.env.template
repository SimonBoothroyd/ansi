# Cloud endpoints + public keys for ONE household's own project. Copy to
# `cloud.env` (gitignored) and fill in. Nothing here is a secret — the
# publishable key is the client-side anon key and both URLs ship inside the
# app binary (docs/SECURITY.md) — but they name a private family's
# infrastructure, so the real values are never committed. Never put secrets
# here either. Read by scripts/cloud_verify.sh and by `flutter run` against
# cloud (docs/cloud-setup.md §4).

CLOUD_SUPABASE_URL=https://FILL_ME.supabase.co
# Supabase → Project Settings → API Keys → "publishable" (sb_publishable_…)
CLOUD_SUPABASE_PUBLISHABLE_KEY=FILL_ME
# PowerSync dashboard → the instance URL (https://<id>.powersync.journeyapps.com)
CLOUD_POWERSYNC_URL=FILL_ME
