# --- Secrets / env ---
.env
.env.local
# The household's own cloud endpoints: public-by-design values, but they
# identify one family's project, so they stay out of the repo (template beside).
cloud.env
supabase/signing_keys.json
app/lib/app_config.dart

# --- Dart / Flutter ---
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/coverage/
app/.packages
# PowerSync SQLite core extension for host tests — fetched per-machine by
# scripts/fetch_powersync_core.sh (a binary, and OS/arch specific).
app/libpowersync.dylib
app/libpowersync.so
app/.powersync-core-version
**/*.g.dart.bak
**/doc/api/

# Generated code IS committed (kept out of ignore on purpose):
#   *.g.dart / *.freezed.dart are generated but tracked so CI/analysis is stable.

# --- Platform build dirs (regenerated by `flutter create .`) ---
app/android/local.properties   # machine-specific SDK paths
app/android/.gradle/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/ios/Pods/
app/ios/.symlinks/
app/web/.dart_tool/

# --- Supabase local ---
supabase/.branches/
supabase/.temp/

# --- Deno / edge functions ---
supabase/functions/**/deno.lock

# --- Node (evals runner, if used) ---
evals/node_modules/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.iml

# Local scratch space (screenshots, throwaway files)
scratch/

# Agent worktrees — `git worktree` checkouts live here during parallel agent
# runs. They are working copies of this repo, never content of it.
.claude/worktrees/

# Eval RUN OUTPUT (scorecards, per-provider reports). Regenerated by the runner
# from the tracked datasets + gold; a committed report is a snapshot that rots
# the moment a prompt or scorer changes.
evals/reports/

# The extraction corpus is LOCAL ONLY. The photos carry GPS EXIF and are
# copyrighted cookbook pages; the gold labels transcribe those pages, and a
# saved run holds the model's verbatim reading of them. None of it may be
# committed. Only the contract (gold/_SCHEMA.md), the runner and runs/README.md
# are tracked; evals/README.md says how to build your own corpus.
evals/datasets/extraction/images/
evals/datasets/extraction/gold/*.json
evals/datasets/extraction/gold/_INDEX.md
evals/runs/*/
