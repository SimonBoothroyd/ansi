# --- Secrets / env ---
.env
.env.local
supabase/signing_keys.json
app/lib/app_config.dart

# --- Dart / Flutter ---
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/coverage/
app/.packages
app/pubspec.lock            # app is not a published package; lock left to devs (flip to tracked if you prefer)
**/*.g.dart.bak
**/doc/api/

# Generated code IS committed (kept out of ignore on purpose):
#   *.g.dart / *.freezed.dart are generated but tracked so CI/analysis is stable.

# --- Platform build dirs (regenerated by `flutter create .`) ---
app/android/local.properties   # machine-specific SDK paths
app/android/.gradle/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/ios/Pods/
app/ios/.symlinks/
app/web/.dart_tool/

# --- Supabase local ---
supabase/.branches/
supabase/.temp/

# --- Deno / edge functions ---
supabase/functions/**/deno.lock

# --- Node (evals runner, if used) ---
evals/node_modules/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.iml
