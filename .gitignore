# --- Secrets / env ---
.env
.env.local
supabase/signing_keys.json
app/lib/app_config.dart

# --- Dart / Flutter ---
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/coverage/
app/.packages
# PowerSync SQLite core extension for host tests — fetched per-machine by
# scripts/fetch_powersync_core.sh (a binary, and OS/arch specific).
app/libpowersync.dylib
app/libpowersync.so
app/.powersync-core-version
**/*.g.dart.bak
**/doc/api/

# Generated code IS committed (kept out of ignore on purpose):
#   *.g.dart / *.freezed.dart are generated but tracked so CI/analysis is stable.

# --- Platform build dirs (regenerated by `flutter create .`) ---
app/android/local.properties   # machine-specific SDK paths
app/android/.gradle/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/ios/Pods/
app/ios/.symlinks/
app/web/.dart_tool/

# --- Supabase local ---
supabase/.branches/
supabase/.temp/

# --- Deno / edge functions ---
supabase/functions/**/deno.lock

# --- Node (evals runner, if used) ---
evals/node_modules/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.iml

# Local scratch space (screenshots, throwaway files)
scratch/

# Benchmark raw recipe photos — kept LOCAL ONLY. They carry GPS EXIF and are
# copyrighted cookbook pages, so the raw images must never be committed. Only the
# derived, human-verified gold labels (evals/datasets/extraction/gold/) are tracked.
evals/datasets/extraction/images/
