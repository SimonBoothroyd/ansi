# Cloud endpoints + public keys — committed on purpose (all public-by-design;
# see docs/SECURITY.md: the publishable key is the client-side anon key, and
# both URLs ship inside the app binary anyway). Never put secrets here.
# Used by scripts/cloud_verify.sh and for `flutter run` against cloud
# (docs/cloud-setup.md §4).

CLOUD_SUPABASE_URL=https://REDACTED-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → "publishable" (sb_publishable_…)
CLOUD_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REDACTED
# PowerSync dashboard → the instance URL (https://<id>.powersync.journeyapps.com)
CLOUD_POWERSYNC_URL=FILL_ME
