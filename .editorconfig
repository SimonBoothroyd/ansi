root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.dart]
indent_size = 2
max_line_length = 100

[*.{yaml,yml,json,jsonc}]
indent_size = 2

[*.{ts,tsx}]
indent_size = 2

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
