# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# The Flutter app reads these via --dart-define (see Makefile `run`/`test` targets);
# `make db-up` reads the PowerSync-service vars for docker/compose.yaml.

# --- Supabase (project settings > API; locally: `supabase status`) ---
# Local defaults: URL http://127.0.0.1:54321, ANON_KEY from `supabase status`.
# On the iOS simulator 127.0.0.1 is the Mac host (shared net). Supabase local
# now issues ASYMMETRIC (ES256) user tokens — PowerSync verifies them via JWKS
# (below), not a shared secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- PowerSync (service container reads these via docker/compose.yaml) ---
# The sync-service endpoint the app connects to. Local self-hosted: http://127.0.0.1:8080.
POWERSYNC_URL=
# JWKS endpoint PowerSync fetches ES256 public keys from (defaults to the local
# Supabase one in compose.yaml). host.docker.internal = the Mac from a container.
POWERSYNC_JWKS_URI=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# Postgres the PowerSync service replicates from + stores buckets in. Discrete
# fields (not a URI): jpgwire only honours sslmode: disable this way. From the
# container the local Supabase DB is host.docker.internal:54322.
POWERSYNC_PG_HOST=host.docker.internal
POWERSYNC_PG_PORT=54322
POWERSYNC_PG_DATABASE=postgres
POWERSYNC_PG_USER=postgres
POWERSYNC_PG_PASSWORD=postgres

# --- Server-side only (edge functions; set as Supabase secrets, not in the app) ---
# The extraction model key. Gemini Flash is the default (ADR-0004 / spec §4.3).
EXTRACTION_MODEL_API_KEY=
